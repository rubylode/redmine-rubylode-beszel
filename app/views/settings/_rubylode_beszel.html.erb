<% settings_reader = RubylodeBeszel::Settings.new(settings) %>
<% if @validation_errors.present? %>
  <div id="errorExplanation" class="rubylode-beszel-errors">
    <ul>
      <% @validation_errors.each do |message| %><li><%= message %></li><% end %>
    </ul>
  </div>
<% end %>
<% scope = "rubylode_beszel.settings" %>
<% page_scope = "rubylode_beszel.settings_page" %>
<% text_value = ->(key) { settings[key].nil? ? RubylodeBeszel::Settings::DEFAULTS[key] : settings[key] } %>
<% variable_state = ->(name) { name.nil? ? l("#{page_scope}.variable_is_not_allowed") : (ENV[name].to_s.empty? ? l("#{page_scope}.variable_is_not_set") : l("#{page_scope}.variable_is_set")) } %>
<% column_options = ->(key) { options_for_select([[l("#{page_scope}.column_left"), "left"], [l("#{page_scope}.column_right"), "right"]], text_value.call(key)) } %>
<% status_plugin_present = RubylodeBeszel::StatusWidget.status_plugin_present? %>

<%= render partial: "rubylode_beszel/status_plugin_notice" %>

<p>
  <label for="settings_base_url"><%= l("#{scope}.base_url.label") %></label>
  <%= text_field_tag "settings[base_url]", text_value.call("base_url"), size: 60, id: "settings_base_url", placeholder: "https://beszel.example.com" %>
  <em class="info"><%= l("#{scope}.base_url.hint") %></em>
</p>

<p>
  <label for="settings_email_environment_variable"><%= l("#{scope}.email_environment_variable.label") %></label>
  <%= text_field_tag "settings[email_environment_variable]", text_value.call("email_environment_variable"), size: 30, id: "settings_email_environment_variable" %>
  <em class="info">
    <%= l("#{scope}.email_environment_variable.hint") %>
    <strong><%= variable_state.call(settings_reader.email_environment_variable) %></strong>
  </em>
</p>

<p>
  <label for="settings_password_environment_variable"><%= l("#{scope}.password_environment_variable.label") %></label>
  <%= text_field_tag "settings[password_environment_variable]", text_value.call("password_environment_variable"), size: 30, id: "settings_password_environment_variable" %>
  <em class="info">
    <%= l("#{scope}.password_environment_variable.hint") %>
    <strong><%= variable_state.call(settings_reader.password_environment_variable) %></strong>
  </em>
</p>

<p>
  <label for="settings_allowed_hosts"><%= l("#{scope}.allowed_hosts.label") %></label>
  <%= text_field_tag "settings[allowed_hosts]", text_value.call("allowed_hosts"), size: 60, id: "settings_allowed_hosts" %>
  <em class="info"><%= l("#{scope}.allowed_hosts.hint") %></em>
</p>

<p>
  <label for="settings_allow_plain_http"><%= l("#{scope}.allow_plain_http.label") %></label>
  <%= hidden_field_tag "settings[allow_plain_http]", "0", id: nil %>
  <%= check_box_tag "settings[allow_plain_http]", "1", text_value.call("allow_plain_http").to_s == "1", id: "settings_allow_plain_http" %>
  <em class="info"><%= l("#{scope}.allow_plain_http.hint") %></em>
</p>

<p>
  <label for="settings_systems"><%= l("#{scope}.systems.label") %></label>
  <%= text_area_tag "settings[systems]", text_value.call("systems"), rows: 8, cols: 90, id: "settings_systems", class: "wiki-edit", placeholder: l("#{scope}.systems.example") %>
  <em class="info"><%= l("#{scope}.systems.hint") %></em>
</p>

<p>
  <label for="settings_block_title"><%= l("#{scope}.block_title.label") %></label>
  <%= text_field_tag "settings[block_title]", text_value.call("block_title"), size: 30, id: "settings_block_title" %>
  <em class="info"><%= l("#{scope}.block_title.hint") %></em>
</p>

<p>
  <label for="settings_visibility"><%= l("#{scope}.visibility.label") %></label>
  <%= select_tag "settings[visibility]", options_for_select([[l("#{scope}.visibility.logged_in"), "logged_in"], [l("#{scope}.visibility.admins"), "admins"]], text_value.call("visibility")), id: "settings_visibility" %>
</p>

<h3><%= l("#{page_scope}.placements_heading") %></h3>
<p class="info"><%= l("#{page_scope}.placements_intro") %></p>

<p>
  <label for="settings_show_on_welcome_page"><%= l("#{scope}.show_on_welcome_page.label") %></label>
  <%= hidden_field_tag "settings[show_on_welcome_page]", "0", id: nil %>
  <%= check_box_tag "settings[show_on_welcome_page]", "1", text_value.call("show_on_welcome_page").to_s == "1", id: "settings_show_on_welcome_page" %>
  <label for="settings_welcome_page_column" class="inline"><%= l("#{scope}.welcome_page_column.label") %></label>
  <%= select_tag "settings[welcome_page_column]", column_options.call("welcome_page_column"), id: "settings_welcome_page_column" %>
  <em class="info"><%= l("#{scope}.show_on_welcome_page.hint") %></em>
</p>

<p>
  <label for="settings_show_on_my_page"><%= l("#{scope}.show_on_my_page.label") %></label>
  <%= hidden_field_tag "settings[show_on_my_page]", "0", id: nil %>
  <%= check_box_tag "settings[show_on_my_page]", "1", text_value.call("show_on_my_page").to_s == "1", id: "settings_show_on_my_page" %>
  <em class="info"><%= l("#{scope}.show_on_my_page.hint") %></em>
</p>

<p>
  <label for="settings_show_on_project_overview"><%= l("#{scope}.show_on_project_overview.label") %></label>
  <%= hidden_field_tag "settings[show_on_project_overview]", "0", id: nil %>
  <%= check_box_tag "settings[show_on_project_overview]", "1", text_value.call("show_on_project_overview").to_s == "1", id: "settings_show_on_project_overview" %>
  <label for="settings_project_overview_column" class="inline"><%= l("#{scope}.project_overview_column.label") %></label>
  <%= select_tag "settings[project_overview_column]", column_options.call("project_overview_column"), id: "settings_project_overview_column" %>
  <em class="info"><%= l("#{scope}.show_on_project_overview.hint") %></em>
</p>

<p>
  <label for="settings_show_on_matching_pages"><%= l("#{scope}.show_on_matching_pages.label") %></label>
  <%= hidden_field_tag "settings[show_on_matching_pages]", "0", id: nil %>
  <%= check_box_tag "settings[show_on_matching_pages]", "1", text_value.call("show_on_matching_pages").to_s == "1", id: "settings_show_on_matching_pages" %>
  <em class="info"><%= l("#{scope}.show_on_matching_pages.hint") %></em>
</p>

<p>
  <label for="settings_matching_page_paths"><%= l("#{scope}.matching_page_paths.label") %></label>
  <%= text_area_tag "settings[matching_page_paths]", text_value.call("matching_page_paths"), rows: 4, cols: 60, id: "settings_matching_page_paths", placeholder: l("#{scope}.matching_page_paths.example") %>
  <em class="info"><%= l("#{scope}.matching_page_paths.hint") %></em>
</p>

<% if status_plugin_present %>
  <%# Rubylode Status owns the top menu item, so the choice is not offered. The saved value is kept. %>
  <%= hidden_field_tag "settings[show_in_top_menu]", text_value.call("show_in_top_menu"), id: nil %>
<% else %>
  <p>
    <label for="settings_show_in_top_menu"><%= l("#{scope}.show_in_top_menu.label") %></label>
    <%= hidden_field_tag "settings[show_in_top_menu]", "0", id: nil %>
    <%= check_box_tag "settings[show_in_top_menu]", "1", text_value.call("show_in_top_menu").to_s == "1", id: "settings_show_in_top_menu" %>
    <em class="info"><%= l("#{scope}.show_in_top_menu.hint") %></em>
  </p>
<% end %>

<h3><%= l("#{page_scope}.help_heading") %></h3>
<div class="rubylode-beszel-help">
  <table class="list">
    <thead>
      <tr><th><%= l("#{page_scope}.help_place") %></th><th><%= l("#{page_scope}.help_how") %></th><th><%= l("#{page_scope}.help_needs_setting") %></th></tr>
    </thead>
    <tbody>
      <% %w[wiki news descriptions welcome_text my_page_block welcome_page my_page overview paths page top_menu partial].each do |row| %>
        <tr>
          <td><%= l("#{page_scope}.help_rows.#{row}.place") %></td>
          <td><%= l("#{page_scope}.help_rows.#{row}.how") %></td>
          <td><%= l("#{page_scope}.help_rows.#{row}.setting") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <p><%= l("#{page_scope}.help_macro_intro") %></p>
  <pre><code>{{beszel_status}}
{{beszel_status(title=Our servers)}}</code></pre>
  <p><%= l("#{page_scope}.help_welcome_text") %></p>
  <p><%= l("#{page_scope}.help_partial_intro") %></p>
  <pre><code>&lt;%= render partial: "rubylode_beszel/status" %&gt;
&lt;%= render partial: "rubylode_beszel/status", locals: { compact: true, title: "Servers", show_title: false } %&gt;</code></pre>
  <p><%= l("#{page_scope}.help_partial_locals") %></p>
  <p><%= l("#{page_scope}.help_page_link") %> <code>"Servers":/status/beszel</code></p>
</div>

<p>
  <label for="settings_cache_seconds"><%= l("#{scope}.cache_seconds.label") %></label>
  <%= number_field_tag "settings[cache_seconds]", text_value.call("cache_seconds"), min: 0, size: 6, id: "settings_cache_seconds" %>
  <em class="info"><%= l("#{scope}.cache_seconds.hint") %></em>
</p>

<p>
  <label for="settings_failure_cache_seconds"><%= l("#{scope}.failure_cache_seconds.label") %></label>
  <%= number_field_tag "settings[failure_cache_seconds]", text_value.call("failure_cache_seconds"), min: 0, size: 6, id: "settings_failure_cache_seconds" %>
  <em class="info"><%= l("#{scope}.failure_cache_seconds.hint") %></em>
</p>

<p>
  <label for="settings_timeout_seconds"><%= l("#{scope}.timeout_seconds.label") %></label>
  <%= number_field_tag "settings[timeout_seconds]", text_value.call("timeout_seconds"), min: 1, size: 6, id: "settings_timeout_seconds" %>
  <em class="info"><%= l("#{scope}.timeout_seconds.hint") %></em>
</p>
