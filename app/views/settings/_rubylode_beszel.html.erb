<% configuration = RubylodeBeszel::Configuration.new(settings) %>
<% if @validation_errors.present? %>
  <div id="errorExplanation" class="rubylode-beszel-errors">
    <ul>
      <% @validation_errors.each do |message| %><li><%= message %></li><% end %>
    </ul>
  </div>
<% end %>
<% scope = "rubylode_beszel.settings" %>
<% text_value = ->(key) { settings[key].nil? ? RedmineRubylodeBeszel::Defaults::SETTINGS[key] : settings[key] } %>
<% variable_state = ->(name) { name.nil? ? l("#{scope}.variable_is_not_allowed") : (ENV[name].to_s.empty? ? l("#{scope}.variable_is_not_set") : l("#{scope}.variable_is_set")) } %>

<p>
  <label for="settings_hub_url"><%= l("#{scope}.hub_url") %></label>
  <%= text_field_tag "settings[hub_url]", text_value.call("hub_url"), size: 60, id: "settings_hub_url", placeholder: "https://beszel.example.com" %>
  <em class="info"><%= l("#{scope}.hub_url_hint") %></em>
</p>

<p>
  <label for="settings_allow_plain_http"><%= l("#{scope}.allow_plain_http") %></label>
  <%= hidden_field_tag "settings[allow_plain_http]", "0", id: nil %>
  <%= check_box_tag "settings[allow_plain_http]", "1", text_value.call("allow_plain_http").to_s == "1", id: "settings_allow_plain_http" %>
  <em class="info"><%= l("#{scope}.allow_plain_http_hint") %></em>
</p>

<p>
  <label for="settings_allowed_hosts"><%= l("#{scope}.allowed_hosts") %></label>
  <%= text_field_tag "settings[allowed_hosts]", text_value.call("allowed_hosts"), size: 60, id: "settings_allowed_hosts" %>
  <em class="info"><%= l("#{scope}.allowed_hosts_hint") %></em>
</p>

<p>
  <label for="settings_email_environment_variable"><%= l("#{scope}.email_environment_variable") %></label>
  <%= text_field_tag "settings[email_environment_variable]", text_value.call("email_environment_variable"), size: 30, id: "settings_email_environment_variable" %>
  <em class="info">
    <%= l("#{scope}.email_environment_variable_hint") %>
    <strong><%= variable_state.call(configuration.email_environment_variable) %></strong>
  </em>
</p>

<p>
  <label for="settings_password_environment_variable"><%= l("#{scope}.password_environment_variable") %></label>
  <%= text_field_tag "settings[password_environment_variable]", text_value.call("password_environment_variable"), size: 30, id: "settings_password_environment_variable" %>
  <em class="info">
    <%= l("#{scope}.password_environment_variable_hint") %>
    <strong><%= variable_state.call(configuration.password_environment_variable) %></strong>
  </em>
</p>

<p>
  <label for="settings_systems"><%= l("#{scope}.systems") %></label>
  <%= text_area_tag "settings[systems]", text_value.call("systems"), rows: 8, cols: 90, id: "settings_systems", class: "wiki-edit", placeholder: l("#{scope}.systems_example") %>
  <em class="info"><%= l("#{scope}.systems_hint") %></em>
</p>

<p>
  <label for="settings_block_title"><%= l("#{scope}.block_title") %></label>
  <%= text_field_tag "settings[block_title]", text_value.call("block_title"), size: 30, id: "settings_block_title" %>
</p>

<p>
  <label for="settings_visibility"><%= l("#{scope}.visibility") %></label>
  <%= select_tag "settings[visibility]", options_for_select([[l("#{scope}.visibility_logged_in"), "logged_in"], [l("#{scope}.visibility_admins"), "admins"]], text_value.call("visibility")), id: "settings_visibility" %>
</p>

<h3><%= l("#{scope}.placements_heading") %></h3>
<p class="info"><%= l("#{scope}.placements_intro") %></p>

<p>
  <label for="settings_show_on_welcome_page"><%= l("#{scope}.show_on_welcome_page") %></label>
  <%= hidden_field_tag "settings[show_on_welcome_page]", "0", id: nil %>
  <%= check_box_tag "settings[show_on_welcome_page]", "1", text_value.call("show_on_welcome_page").to_s == "1", id: "settings_show_on_welcome_page" %>
  <%= select_tag "settings[welcome_page_column]", options_for_select([[l("#{scope}.column_left"), "left"], [l("#{scope}.column_right"), "right"]], text_value.call("welcome_page_column")), id: "settings_welcome_page_column" %>
</p>

<p>
  <label for="settings_show_on_my_page"><%= l("#{scope}.show_on_my_page") %></label>
  <%= hidden_field_tag "settings[show_on_my_page]", "0", id: nil %>
  <%= check_box_tag "settings[show_on_my_page]", "1", text_value.call("show_on_my_page").to_s == "1", id: "settings_show_on_my_page" %>
  <em class="info"><%= l("#{scope}.show_on_my_page_hint") %></em>
</p>

<p>
  <label for="settings_show_on_project_overview"><%= l("#{scope}.show_on_project_overview") %></label>
  <%= hidden_field_tag "settings[show_on_project_overview]", "0", id: nil %>
  <%= check_box_tag "settings[show_on_project_overview]", "1", text_value.call("show_on_project_overview").to_s == "1", id: "settings_show_on_project_overview" %>
  <%= select_tag "settings[project_overview_column]", options_for_select([[l("#{scope}.column_left"), "left"], [l("#{scope}.column_right"), "right"]], text_value.call("project_overview_column")), id: "settings_project_overview_column" %>
</p>

<p>
  <label for="settings_show_in_top_menu"><%= l("#{scope}.show_in_top_menu") %></label>
  <%= hidden_field_tag "settings[show_in_top_menu]", "0", id: nil %>
  <%= check_box_tag "settings[show_in_top_menu]", "1", text_value.call("show_in_top_menu").to_s == "1", id: "settings_show_in_top_menu" %>
  <em class="info"><%= l("#{scope}.show_in_top_menu_hint") %></em>
</p>

<p>
  <label for="settings_show_on_paths"><%= l("#{scope}.show_on_paths") %></label>
  <%= text_area_tag "settings[show_on_paths]", text_value.call("show_on_paths"), rows: 4, cols: 60, id: "settings_show_on_paths", placeholder: l("#{scope}.show_on_paths_example") %>
  <em class="info"><%= l("#{scope}.show_on_paths_hint") %></em>
</p>

<h3><%= l("#{scope}.help_heading") %></h3>
<div class="rubylode-beszel-help">
  <table class="list">
    <thead>
      <tr><th><%= l("#{scope}.help_place") %></th><th><%= l("#{scope}.help_how") %></th><th><%= l("#{scope}.help_needs_setting") %></th></tr>
    </thead>
    <tbody>
      <% %w[wiki news descriptions welcome_text my_page_block welcome_page my_page overview paths page top_menu partial].each do |row| %>
        <tr>
          <td><%= l("#{scope}.help_rows.#{row}.place") %></td>
          <td><%= l("#{scope}.help_rows.#{row}.how") %></td>
          <td><%= l("#{scope}.help_rows.#{row}.setting") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <p><%= l("#{scope}.help_macro_intro") %></p>
  <pre><code>{{beszel_status}}
{{beszel_status(title=Our servers)}}</code></pre>
  <p><%= l("#{scope}.help_welcome_text") %></p>
  <p><%= l("#{scope}.help_partial_intro") %></p>
  <pre><code>&lt;%= render partial: "rubylode_beszel/status" %&gt;
&lt;%= render partial: "rubylode_beszel/status", locals: { compact: true, title: "Servers", show_title: false } %&gt;</code></pre>
  <p><%= l("#{scope}.help_partial_locals") %></p>
  <p><%= l("#{scope}.help_page_link") %> <code>"Servers":/beszel_status</code></p>
</div>

<p>
  <label for="settings_cache_seconds"><%= l("#{scope}.cache_seconds") %></label>
  <%= number_field_tag "settings[cache_seconds]", text_value.call("cache_seconds"), min: 0, size: 6, id: "settings_cache_seconds" %>
  <em class="info"><%= l("#{scope}.cache_seconds_hint") %></em>
</p>

<p>
  <label for="settings_failure_cache_seconds"><%= l("#{scope}.failure_cache_seconds") %></label>
  <%= number_field_tag "settings[failure_cache_seconds]", text_value.call("failure_cache_seconds"), min: 0, size: 6, id: "settings_failure_cache_seconds" %>
  <em class="info"><%= l("#{scope}.failure_cache_seconds_hint") %></em>
</p>

<p>
  <label for="settings_timeout_seconds"><%= l("#{scope}.timeout_seconds") %></label>
  <%= number_field_tag "settings[timeout_seconds]", text_value.call("timeout_seconds"), min: 1, size: 6, id: "settings_timeout_seconds" %>
</p>
